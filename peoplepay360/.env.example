# Port 5433 — docker-compose maps the container off 5432 to avoid clashing with
# a natively installed Postgres.
DATABASE_URL="postgresql://peoplepay:peoplepay@localhost:5433/peoplepay360?schema=public"

# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="PeoplePay360 <payroll@oxp.com>"

APP_NAME="PeoplePay360"
COMPANY_CURRENCY="INR"
