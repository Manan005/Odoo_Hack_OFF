# One ignore file for the whole repository.
# Patterns are unanchored, so they apply at the root and inside peoplepay360/.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment files — the example template carries no secrets and every clone needs it
.env
.env.*
!.env.example

# Platform
.vercel/
.claude/

# Working notes and generated material, kept out of the repo on purpose
docs/
graphify-out/
Dashboard inspiration/

# Logs, OS and editor noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem
